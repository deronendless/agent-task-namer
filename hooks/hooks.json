{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/agent-task-namer/scripts/session_start.py\"",
            "timeout": 3,
            "additionalContextLimit": 600
          }
        ]
      }
    ]
  }
}
